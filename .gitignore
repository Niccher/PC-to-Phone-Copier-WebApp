.vagrant
Vagrantfile
auth.json

# Temporary & Writable Files
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html
writable/debugbar/*
!writable/debugbar/index.html
writable/backups/*
!writable/backups/index.html
writable/exports/*
!writable/exports/index.html
php_errors.log

# Generated QR Codes & Uploaded Media
public/assets/media/*.png
public/assets/media/uploads/

